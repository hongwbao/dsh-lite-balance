{
  "name": "dsh-lite-balance",
  "version": "0.1.0",
  "description": "Lightweight DeepSeek account balance display for the dsh web GUI: a compact sidebar-footer chip with status colors, auto/manual refresh, low-balance alert and one-click top-up. · 轻量余额显示器：侧边栏底部紧凑 chip，状态变色、自动/手动刷新、低余额提醒、一键充值。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "balance",
    "余额"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
